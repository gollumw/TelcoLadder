  "repository": {
    "url": "https://github.com/gollumw/TelcoLadder",
    "source": "github"
  },
  "websiteUrl": "https://github.com/gollumw/TelcoLadder/blob/master/AGENTS.md",
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "telcoladder",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
